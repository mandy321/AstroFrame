<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="32dp"
    android:background="@color/bg_dark">

    <!-- Left Column: Live Preview & Metadata -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="6"
        android:orientation="vertical"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_preview"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:layout_marginBottom="12dp" />

        <!-- 16:9 Aspect Frame for Preview with Live Mat Frame Rendering -->
        <com.astroframe.tv.ui.MuseumFrameView
            android:id="@+id/previewMuseumFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_bg">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/title_preview" />

                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:text="@string/no_wallpaper_yet" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </com.astroframe.tv.ui.MuseumFrameView>

        <!-- Apple tvOS-Style Translucent Frosted Glass Artwork Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_apple_frosted_glass"
            android:padding="20dp"
            android:elevation="6dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvCurrentDateCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦ CURATED GALLERY • APOD"
                android:textColor="#A0B3D6"
                android:textSize="12sp"
                android:letterSpacing="0.06"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AstroFrame Deep Space"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvCurrentExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ultra-high definition imagery curated for your living room."
                android:textColor="#D0D6E0"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Ready"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right Column: Settings & Remote Actions -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controls &amp; Settings"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <!-- Primary Action: Update Now -->
            <Button
                android:id="@+id/btnRefreshNow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_refresh"
                android:background="@drawable/tv_button_primary_bg"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Overlay Position Toggle -->
            <Button
                android:id="@+id/btnOverlayPos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Overlay: Top Left"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Collection Source Selection -->
            <Button
                android:id="@+id/btnArtSource"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Collection: NASA Cosmos"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Interval Selection (Opens Quick Picker) -->
            <Button
                android:id="@+id/btnInterval"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Interval: 30 Mins"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Photo Mode Toggle -->
            <Button
                android:id="@+id/btnMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Mode: Random Archive"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Custom API Key Button -->
            <Button
                android:id="@+id/btnApiKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="NASA API Key"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

                        <!-- Museum Frame Matting Style Button (The Frame Rival) -->
            <Button
                android:id="@+id/btnMatStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Frame: Teak Wood 🪵"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- OLED Care & Pixel-Shift Toggle -->
            <Button
                android:id="@+id/btnOledCare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="OLED Care: Active 🛡️"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Screensaver Photo Rotation Button -->
            <Button
                android:id="@+id/btnScreensaverRotation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Photo Rotation: 1 Min"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Set as TV Screensaver Shortcut -->
            <Button
                android:id="@+id/btnScreensaverSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Set as TV Screensaver 📺"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Set as Default TV Wallpaper Shortcut -->
            <Button
                android:id="@+id/btnWallpaperSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Set as TV Wallpaper 🖼️"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Check for Updates Button -->
            <Button
                android:id="@+id/btnCheckUpdates"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Check for Updates 🚀"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- About & Version Info Button -->
            <Button
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="About AstroFrame ℹ️"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="12dp" />

            <!-- Setup Guide Button -->
            <Button
                android:id="@+id/btnSetupGuide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_setup_guide"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="16dp" />

            <!-- Storage Location Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Target Folder for Projectivy:\n/sdcard/Pictures/AstroFrame"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

