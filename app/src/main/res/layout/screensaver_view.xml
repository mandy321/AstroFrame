<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screensaverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Museum Framing Layer -->
    <com.astroframe.tv.ui.MuseumFrameView
        android:id="@+id/museumFrameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <FrameLayout
            android:id="@+id/artCanvasContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgScreensaverBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Screensaver Image" />

            <ImageView
                android:id="@+id/imgScreensaverFront"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Screensaver Image" />

        </FrameLayout>

    </com.astroframe.tv.ui.MuseumFrameView>

    <!-- Top-Right: Apple tvOS-style Ambient Clock & Weather Pill -->
    <LinearLayout
        android:id="@+id/topBarPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="36dp"
        android:background="@drawable/bg_apple_frosted_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="10:25 AM"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.04" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#4DFFFFFF" />

        <TextView
            android:id="@+id/txtWeatherBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="Clear Skies ✦"
            android:textColor="#A0B3D6"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Top-Left: AuraMusic Now-Playing Translucent Island -->
    <LinearLayout
        android:id="@+id/auraMusicPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="36dp"
        android:background="@drawable/bg_apple_frosted_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♫"
            android:textColor="#8A2BE2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMusicTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="AuraMusic Active"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtMusicArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="Bit-Perfect Lossless Stream"
                android:textColor="#A0B3D6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-Left: Apple tvOS-style Floating Telemetry & Interactive Remote Pill -->
    <LinearLayout
        android:id="@+id/telemetryPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="36dp"
        android:background="@drawable/bg_apple_frosted_glass"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/txtTelemetryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ 10-BIT WIDE GAMUT • OLED PROTECTED"
            android:textColor="#A0B3D6"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtArtworkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="AstroFrame Deep Space"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:shadowColor="#80000000"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/txtArtworkSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-light"
            android:text="NASA / ESA Observatory"
            android:textColor="#D0D6E0"
            android:textSize="13sp" />

        <!-- Remote D-pad Hint Pill -->
        <TextView
            android:id="@+id/txtRemoteHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="◀ Previous  •  OK Info  •  Next ▶  •  Pause ⏸"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.04" />

    </LinearLayout>

</FrameLayout>
