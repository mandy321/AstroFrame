<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screensaverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Museum Framing Layer -->
    <com.astroframe.tv.ui.MuseumFrameView
        android:id="@+id/museumFrameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <FrameLayout
            android:id="@+id/artCanvasContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgScreensaverBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Screensaver Image" />

            <ImageView
                android:id="@+id/imgScreensaverFront"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Screensaver Image" />

        </FrameLayout>

    </com.astroframe.tv.ui.MuseumFrameView>

    <!-- Top-Right: Ambient Clock & Weather Pill (Subtle & Blended) -->
    <LinearLayout
        android:id="@+id/topBarPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="36dp"
        android:background="@drawable/bg_apple_frosted_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:alpha="0.82"
        android:elevation="4dp">

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="10:25 AM"
            android:textColor="#E0E6ED"
            android:textSize="13sp"
            android:letterSpacing="0.03" />

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/txtWeatherBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="Clear Skies ✦"
            android:textColor="#9AB0D1"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Top-Left: AuraMusic Now-Playing Translucent Island -->
    <LinearLayout
        android:id="@+id/auraMusicPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="36dp"
        android:background="@drawable/bg_apple_frosted_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♫"
            android:textColor="#8A2BE2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMusicTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="AuraMusic Active"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtMusicArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="Bit-Perfect Lossless Stream"
                android:textColor="#A0B3D6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-Left: Floating Artwork Description (Elegantly Blended into Artwork) -->
    <LinearLayout
        android:id="@+id/telemetryPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="36dp"
        android:background="@drawable/bg_apple_frosted_glass"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:alpha="0.88"
        android:elevation="4dp">

        <TextView
            android:id="@+id/txtTelemetryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ 10-BIT WIDE GAMUT • OLED PROTECTED"
            android:textColor="#8EA4C7"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/txtArtworkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="AstroFrame Deep Space"
            android:textColor="#F0F4F8"
            android:textSize="16sp"
            android:shadowColor="#99000000"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/txtArtworkSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-light"
            android:text="NASA / ESA Observatory"
            android:textColor="#B8C4D4"
            android:textSize="12sp" />

        <!-- Remote D-pad Hint Pill -->
        <TextView
            android:id="@+id/txtRemoteHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="◀ Previous  •  OK Info  •  Next ▶  •  Pause ⏸"
            android:textColor="#55FFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.04" />

    </LinearLayout>

</FrameLayout>
