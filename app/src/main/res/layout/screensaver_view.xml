<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screensaverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Museum Framing Layer -->
    <com.astroframe.tv.ui.MuseumFrameView
        android:id="@+id/museumFrameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <FrameLayout
            android:id="@+id/artCanvasContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgScreensaverBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Screensaver Image" />

            <ImageView
                android:id="@+id/imgScreensaverFront"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Screensaver Image" />

        </FrameLayout>

    </com.astroframe.tv.ui.MuseumFrameView>

    <!-- Top-Right: Discreet Time & Weather Pill (Whisper-light, ultra-transparent, compact) -->
    <LinearLayout
        android:id="@+id/topBarPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="44dp"
        android:background="@drawable/bg_ultra_light_overlay"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:elevation="0dp">

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="10:25 AM"
            android:textColor="#F4F7FB"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:shadowColor="#EE000000"
            android:shadowDx="1.2"
            android:shadowDy="1.2"
            android:shadowRadius="5" />

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/txtWeatherBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="Clear Skies ✦"
            android:textColor="#C8D4E2"
            android:textSize="12sp"
            android:shadowColor="#EE000000"
            android:shadowDx="1.2"
            android:shadowDy="1.2"
            android:shadowRadius="4" />

    </LinearLayout>

    <!-- Top-Left: AuraMusic Now-Playing Translucent Island -->
    <LinearLayout
        android:id="@+id/auraMusicPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="36dp"
        android:background="@drawable/bg_apple_frosted_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♫"
            android:textColor="#8A2BE2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMusicTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="AuraMusic Active"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtMusicArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="Bit-Perfect Lossless Stream"
                android:textColor="#A0B3D6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-Left: Discreet Ultra-Transparent Artwork Label (Small footprint, elegant typography) -->
    <LinearLayout
        android:id="@+id/telemetryPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="44dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_ultra_light_overlay"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:elevation="0dp">

        <TextView
            android:id="@+id/txtArtworkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="AstroFrame Deep Space"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#EE000000"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="5" />

        <TextView
            android:id="@+id/txtArtworkSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-light"
            android:text="The Met Museum • 1874"
            android:textColor="#D8E2EC"
            android:textSize="11sp"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#EE000000"
            android:shadowDx="1.2"
            android:shadowDy="1.2"
            android:shadowRadius="4" />

        <!-- Hidden technical telemetry to maintain pure gallery aesthetics -->
        <TextView
            android:id="@+id/txtTelemetryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtRemoteHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
